+// BIB: the host owns the linear memory; it can drop the physical pages of a
+// range mimalloc no longer uses (they read as zero afterwards), which is
+// what decommit/reset mean on an OS. A plain import (the embedder's JS
+// library bib_host_lib.js provides a no-op for browsers): a weak reference
+// would resolve to a null stub in wasm-ld and never reach the host.
+void bib_host_discard(void* addr, size_t size);
+void bib_host_discard_now(void* addr, size_t size); // never queued by the host
+
+// Drop the whole 4 KiB pages inside [addr, addr+size): partial pages at the
+// edges stay resident (they may hold neighbouring data or emmalloc's region
+// header/footer).
+static void bib_discard_interior_ex(void* addr, size_t size, size_t keep, int now) {
+  if (size <= 2 * keep + 4096) return; // nothing whole to drop; also guards the subtraction below
+  uintptr_t lo = ((uintptr_t)addr + keep + 4095) & ~(uintptr_t)4095;
+  uintptr_t hi = ((uintptr_t)addr + size - keep) & ~(uintptr_t)4095;
+  if (hi <= lo) return;
+  if (now) bib_host_discard_now((void*)lo, hi - lo);
+  else bib_host_discard((void*)lo, hi - lo);
+}
+static void bib_discard_interior(void* addr, size_t size, size_t keep) { bib_discard_interior_ex(addr, size, keep, 0); }
