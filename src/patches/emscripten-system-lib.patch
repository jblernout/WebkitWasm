+// BIB: visit the payload of every free region (between the size/prev/next
+// header and the size footer) so the embedder can drop their physical pages
+// at reset (bib_reset), all at once, instead of at every free.
+void emmalloc_for_each_free_region(void (*cb)(void* start, size_t size, void* arg), void* arg) {
+  MALLOC_ACQUIRE();
+  for (int i = 0; i < NUM_FREE_BUCKETS; ++i) {
+    if (!(freeRegionBucketsUsed & ((BUCKET_BITMASK_T)1 << i))) continue;
+    Region *head = &freeRegionBuckets[i];
+    for (Region *r = head->next; r && r != head; r = r->next) {
+      uint8_t *start = (uint8_t*)r + sizeof(Region);
+      uint8_t *end = (uint8_t*)r + r->size - sizeof(size_t);
+      if (end > start) cb(start, (size_t)(end - start), arg);
+    }
+  }
+  MALLOC_RELEASE();
+}
