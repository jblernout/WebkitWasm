+    // PLATFORM(PLAYSTATION) || PLATFORM(HAIKU) || __EMSCRIPTEN__ branch).
+    auto wrapper = adoptRef(*new AccessibilityObjectWrapper());
+    object.setWrapper(wrapper.ptr());
