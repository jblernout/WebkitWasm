@@ -0,0 +1,53 @@
+/*
+ * PORT=Emscripten CurlSSLHandle platform half, cribbed from
+ * platform/network/win/CurlSSLHandleWin.cpp (cipher/curve lists) with a
+ * MEMFS CA bundle: the embedder --embed-files a Mozilla-style bundle at
+ * /etc/ssl/cacert.pem (see src/embedder/embedder.cmake). TLS terminates
+ * inside the engine — the Wisp transport below is a plain byte pipe.
+ */
+
+#include "config.h"
+#include "CurlSSLHandle.h"
+
+#include <wtf/FileSystem.h>
+
+namespace WebCore {
+
+void CurlSSLHandle::platformInitialize()
+{
+    constexpr auto cipherList =
+        "TLS_AES_128_GCM_SHA256:"
+        "TLS_CHACHA20_POLY1305_SHA256:"
+        "TLS_AES_256_GCM_SHA384:"
+        "ECDHE-ECDSA-AES128-GCM-SHA256:"
+        "ECDHE-RSA-AES128-GCM-SHA256:"
+        "ECDHE-ECDSA-CHACHA20-POLY1305:"
+        "ECDHE-RSA-CHACHA20-POLY1305:"
+        "ECDHE-ECDSA-AES256-GCM-SHA384:"
+        "ECDHE-RSA-AES256-GCM-SHA384:"
+        "ECDHE-ECDSA-AES256-SHA:"
+        "ECDHE-ECDSA-AES128-SHA:"
+        "ECDHE-RSA-AES128-SHA:"
+        "ECDHE-RSA-AES256-SHA:"
+        "AES128-GCM-SHA256:"
+        "AES256-GCM-SHA384:"
+        "AES128-SHA:"
+        "AES256-SHA";
+
+    constexpr auto ecCurves =
+        "X25519:"
+        "P-256:"
+        "P-384:"
+        "P-521";
+
+    setCipherList(cipherList);
+    setECCurves(ecCurves);
+
+    auto caBundlePath = "/etc/ssl/cacert.pem"_s;
+    if (FileSystem::fileExists(caBundlePath))
+        setCACertPath(String { caBundlePath });
+    else
+        WTFLogAlways("CurlSSLHandle: no CA bundle at /etc/ssl/cacert.pem — all TLS verification will fail");
+}
+
+} // namespace WebCore
