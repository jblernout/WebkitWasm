diff --git a/Source/JavaScriptCore/shell/CMakeLists.txt b/Source/JavaScriptCore/shell/CMakeLists.txt
index 3b1c4e8f3c..d19b4de4f8 100644
--- a/Source/JavaScriptCore/shell/CMakeLists.txt
+++ b/Source/JavaScriptCore/shell/CMakeLists.txt
@@ -123,6 +123,26 @@ WEBKIT_INCLUDE_CONFIG_FILES_IF_EXISTS()
 
 WEBKIT_EXECUTABLE(jsc)
 
+if (EMSCRIPTEN)
+    # Emscripten defaults are a 64KB C stack and a fixed 16MB heap. JSC's
+    # stack reserve zones alone exceed 64KB, making every operation throw
+    # StackOverflowError immediately. Give the engine a real stack and a
+    # growable heap.
+    target_link_options(jsc PRIVATE
+        "SHELL:-sSTACK_SIZE=8MB"
+        "SHELL:-sDEFAULT_PTHREAD_STACK_SIZE=2MB"
+        "SHELL:-sINITIAL_MEMORY=128MB"
+        "SHELL:-sALLOW_MEMORY_GROWTH=1"
+        "SHELL:-sMAXIMUM_MEMORY=4GB")
+endif ()
+
+if (EMSCRIPTEN AND JSC_EMBED_ICU_DATA_FILE)
+    # Embed the ICU data archive into the wasm FS at the same absolute path
+    # ICU compiled in as its default data directory, so udata finds it with
+    # no environment configuration in both node and browser environments.
+    target_link_options(jsc PRIVATE "SHELL:--embed-file ${JSC_EMBED_ICU_DATA_FILE}@${JSC_EMBED_ICU_DATA_FILE}")
+endif ()
+
 if (SHOULD_INSTALL_JS_SHELL)
     install(TARGETS jsc DESTINATION "${LIBEXEC_INSTALL_DIR}")
 endif ()
