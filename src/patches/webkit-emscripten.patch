 void CurlRequest::runOnMainThread(Function<void()>&& task)
 {
+#if defined(__EMSCRIPTEN__)
+    // Single-threaded wasm: transfer callbacks already run on the main
+    // thread, inside curl_multi_perform. ensureOnMainThread would run the
+    // client task inline — re-entering WebCore (and possibly curl itself,
+    // via cancel/pause) from inside a curl callback. Always defer to the
+    // next RunLoop cycle to keep the upstream async contract.
+    callOnMainThread(WTF::move(task));
+#else
     ensureOnMainThread(WTF::move(task));
+#endif
 }
 
