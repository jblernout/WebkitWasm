+/*
+ * PORT=Emscripten WebCrypto link stubs. The OpenSSL WebCrypto backend
+ * (crypto/openssl/*) is DEFERRED to Phase 4 — those sources are written
+ * against BoringSSL and do not compile vs real OpenSSL 3.5 (see
+ * PlatformEmscripten.cmake). The cross-platform WebCrypto core still
+ * references these platform hooks, so satisfy wasm-ld with "not supported"
+ * behavior: no algorithms register, key imports fail cleanly. Remove this
+ * file when the real backend lands.
+ */
+
+#include "config.h"
+#include "CryptoAlgorithmRegistry.h"
+#include "CryptoKeyEC.h"
+#include "CryptoKeyRSA.h"
+
+namespace WebCore {
+
+void CryptoAlgorithmRegistry::platformRegisterAlgorithms()
+{
+}
+
+bool CryptoKeyEC::platformSupportedCurve(NamedCurve)
+{
+    return false;
