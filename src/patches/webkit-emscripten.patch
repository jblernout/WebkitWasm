 {
     RELEASE_ASSERT_WITH_MESSAGE(this != &Thread::currentSingleton(), "We do not support suspending the current thread itself.");
+#if defined(__EMSCRIPTEN__)
+    // Signal-based thread suspension cannot work under wasm: pthread_kill
+    // may not deliver, and the semaphore wait below would deadlock instead
+    // of failing. This build supports exactly one mutator thread per VM
+    // (conservative GC then never scans other threads). Trap deterministically
+    // at the entry point rather than deadlocking or trapping in the handler.
+    RELEASE_ASSERT_WITH_MESSAGE(false, "Thread::suspend is unsupported under Emscripten (one mutator thread per VM)");
+#endif
 #if OS(DARWIN)
     kern_return_t result = thread_suspend(m_platformThread);
